  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "intent": {
            "type": "string",
            "title": "Intent"
          },
          "risk": {
            "type": "string",
            "title": "Risk"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "needs_clarification",
              "blocked",
              "degraded"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "suggested_action": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Action"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trace_id",
          "intent",
          "risk",
          "status",
          "answer"
        ],
        "title": "AskResponse"
      },
      "Citation": {
        "properties": {
          "policy_id": {
            "type": "string",
            "title": "Policy Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "policy_id",
          "title",
          "section",
          "version",
          "excerpt",
          "source"
        ],
        "title": "Citation"
      },
      "DecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionRequest"
      },
      "FeedbackRequest": {
        "properties": {
          "trace_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Trace Id"
          },
          "score": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trace_id",
          "score"
        ],
        "title": "FeedbackRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProposalRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "support_case",
              "escalation",
              "replacement_recommendation"
            ],
            "title": "Action"
          },
          "vehicle_id": {
            "type": "string",
            "pattern": "^V-\\d{3}$",
            "title": "Vehicle Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "pattern": "^[\\w-]+$",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "vehicle_id",
          "idempotency_key"
        ],
        "title": "ProposalRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
